<section class="page-width collection">
  <div class="collection__head">
    <h1 class="page-title">{% render 'en-label', text: collection.title %}</h1>
    {%- if collection.description != blank -%}<div class="rte collection__desc">{{ collection.description }}</div>{%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.per_page -%}
    <div class="toolbar">
      <p class="toolbar__count">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</p>
      <label class="toolbar__sort">
        <span>Sort by</span>
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        <select data-sort>
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
          {%- endfor -%}
        </select>
      </label>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="grid grid--4">
        {%- for product in collection.products -%}
          {% render 'product-card', card_product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="empty">No products here yet. <a href="{{ routes.all_products_collection_url }}">Browse all products</a></p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination: next: 'Next', previous: 'Previous' }}</nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
