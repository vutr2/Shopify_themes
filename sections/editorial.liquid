<section class="editorial page-width{% if section.settings.flip %} editorial--flip{% endif %}">
  <div class="editorial__media">
    {%- if section.settings.video -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1200x' }}
    {%- elsif section.settings.image -%}
      {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 55vw, 100vw' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </div>
  <div class="editorial__copy">
    <h2 class="editorial__heading">{{ section.settings.heading | escape }}</h2>
    <div class="editorial__text rte">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}
      <a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Image or video with text",
  "settings": [
    { "type": "video", "id": "video", "label": "Video", "info": "Plays muted on loop. Overrides the image." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "flip", "label": "Put media on the right", "default": false },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to sweat in" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every piece is printed to order, so nothing sits in a warehouse. Breathable fabric, cut for full range of motion, and prints that hold up wash after wash.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read the story" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Image or video with text" }]
}
{% endschema %}
