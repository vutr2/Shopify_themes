<article class="page-width page-narrow">
  <p class="post__date"><a href="{{ blog.url }}">{% render 'en-label', text: blog.title %}</a> / {{ article.published_at | date: '%b %d, %Y' }}</p>
  <h1 class="page-title">{{ article.title }}</h1>
  {%- if article.image -%}
    <div class="article__hero">{{ article.image | image_url: width: 1600 | image_tag: widths: '600, 1000, 1600', sizes: '(min-width: 990px) 760px, 100vw', alt: article.title }}</div>
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
</article>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
