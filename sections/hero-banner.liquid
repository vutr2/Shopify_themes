<section class="hero hero--{{ section.settings.height }}">
  <div class="hero__media">
    {%- if section.settings.image -%}
      {%- assign hero_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
      {%- if section.settings.image_mobile -%}
        {{ section.settings.image_mobile | image_url: width: 900 | image_tag: class: 'hero__img hero__img--mobile', widths: '450, 750, 900', sizes: '100vw', alt: hero_alt, fetchpriority: 'high' }}
      {%- endif -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hero__img', widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: hero_alt, fetchpriority: 'high' }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder hero__img' }}
    {%- endif -%}
  </div>
  <div class="hero__copy page-width">
    {%- if section.settings.heading != blank -%}<h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="hero__text">{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "2400 x 1200px recommended" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional. Portrait 900 x 1200px" },
    { "type": "select", "id": "height", "label": "Height", "default": "tall", "options": [
      { "value": "short", "label": "Short" },
      { "value": "tall", "label": "Tall" },
      { "value": "full", "label": "Full screen" }
    ]},
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the last rep" },
    { "type": "text", "id": "text", "label": "Text", "default": "Lightweight tanks and tees that stay out of your way." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop new arrivals" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
