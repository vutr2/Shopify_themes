{%- assign blog = section.settings.blog -%}
<section class="shelf page-width">
  <div class="shelf__head">
    <h2 class="shelf__title">{{ section.settings.heading | escape }}</h2>
    {%- if blog != blank -%}<a class="shelf__all" href="{{ blog.url }}">See all</a>{%- endif -%}
  </div>
  <div class="grid grid--{{ section.settings.limit }} posts">
    {%- if blog != blank and blog.articles_count > 0 -%}
      {%- for article in blog.articles limit: section.settings.limit -%}
        <a class="post" href="{{ article.url }}">
          <div class="post__media">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.title }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <h3 class="post__title">{{ article.title }}</h3>
          <p class="post__date">{{ article.published_at | date: '%b %d, %Y' }}</p>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.limit) -%}
        <div class="post">
          <div class="post__media">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}</div>
          <h3 class="post__title">Your lookbook story</h3>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Lookbook / blog posts",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lookbook" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "select", "id": "limit", "label": "Posts to show", "default": "3", "options": [
      { "value": "2", "label": "2" },
      { "value": "3", "label": "3" },
      { "value": "4", "label": "4" }
    ]}
  ],
  "presets": [{ "name": "Lookbook / blog posts" }]
}
{% endschema %}
