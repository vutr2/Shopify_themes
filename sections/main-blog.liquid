<section class="page-width">
  <h1 class="page-title">{% render 'en-label', text: blog.title %}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="grid grid--3">
      {%- for article in blog.articles -%}
        <a class="post" href="{{ article.url }}">
          <div class="post__media">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.title }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <h2 class="post__title">{{ article.title }}</h2>
          <p class="post__date">{{ article.published_at | date: '%b %d, %Y' }}</p>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination: next: 'Next', previous: 'Previous' }}</nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
