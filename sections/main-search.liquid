<section class="page-width">
  <h1 class="page-title">Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-inline">
    <label class="visually-hidden" for="PageSearch">Search</label>
    <input id="PageSearch" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products">
    <input type="hidden" name="type" value="product">
    <button class="btn" type="submit">Search</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="toolbar__count">{{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }} for “{{ search.terms | escape }}”</p>
      {%- if search.results_count > 0 -%}
        <div class="grid grid--4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', card_product: item %}
            {%- else -%}
              <a class="post" href="{{ item.url }}"><h2 class="post__title">{% render 'en-label', text: item.title %}</h2></a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="empty">Nothing matched. Try a shorter word, like “tank” or “tee”.</p>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination: next: 'Next', previous: 'Previous' }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}
