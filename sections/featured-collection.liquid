{%- assign col = section.settings.collection -%}
<section class="shelf page-width">
  <div class="shelf__head">
    <h2 class="shelf__title">
      {%- if col != blank -%}<a href="{{ col.url }}">{%- if section.settings.heading != blank -%}{{ section.settings.heading | escape }}{%- else -%}{% render 'en-label', text: col.title %}{%- endif -%}</a>
      {%- else -%}{{ section.settings.heading | escape }}{%- endif -%}
    </h2>
    {%- if col != blank -%}<a class="shelf__all" href="{{ col.url }}">See all</a>{%- endif -%}
  </div>
  <div class="grid grid--{{ section.settings.columns }}">
    {%- if col != blank and col.products_count > 0 -%}
      {%- for product in col.products limit: section.settings.limit -%}
        {% render 'product-card', card_product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.limit) -%}
        {% render 'product-card', index: i %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the collection name" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "default": "4", "options": [
      { "value": "3", "label": "3" },
      { "value": "4", "label": "4" }
    ]}
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
