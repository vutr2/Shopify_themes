<section class="page-width">
  <h1 class="page-title">Collections</h1>
  <div class="grid grid--3">
    {%- for col in collections -%}
      {%- if col.products_count > 0 -%}
        <a class="post" href="{{ col.url }}">
          <div class="post__media">
            {%- if col.featured_image -%}
              {{ col.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 50vw', alt: col.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <h2 class="post__title">{% render 'en-label', text: col.title %}</h2>
          <p class="post__date">{{ col.products_count }} {{ col.products_count | pluralize: 'product', 'products' }}</p>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
